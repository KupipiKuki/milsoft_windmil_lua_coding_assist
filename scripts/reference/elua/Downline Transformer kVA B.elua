-- BEGIN DESCRIPTION
--   File Name    : Downline Transformers.elua
--   Version      : WindMil 8.2
--   Input        : None
--   Return       : None
--   Description  : This script returns the count of downline transformers
--   Customer     : None
-- END DESCRIPTION

-- BEGIN META DATA
--<luaelementfield>
-- <name>Downline Transformer kVA B</name>
-- <type>stringTypeEnum</type>
-- <category>fieldCategoryGeneral</category>
-- <getfunction>DownlineTransformerkVAB</getfunction>
-- <setfunction></setfunction>
--</luaelementfield>
-- END META DATA

function DownlineTransformerkVAB ( element )
	local count = 0
  if GetElementField( element, "Type" ) == "Transformer" then
    local kva = GetElementField( element, "Transformer Base Kva B" )
    if kva then
      count = count + kva
    end
  end
  local set = {}
  set = GetChildren( element )
  local i = 1
  local x = 1
  while #set ~= 0 do
    local newSet = {}
    i = 1
    while set[i] do
      if GetElementField( set[i], "Type" ) == "Transformer" then
        local kva = GetElementField( set[i], "Transformer Base Kva B" )
        if kva then
          count = count + kva
        end
      end 
      local children = GetChildren(set[i])
      x = 1
      while children[x] do
        table.insert(newSet,children[x])
        x = x + 1
      end
      i = i + 1
    end
    set = {}
    set = newSet
  end
	return count
end

